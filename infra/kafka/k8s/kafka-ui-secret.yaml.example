# Copy to kafka-ui-secret.yaml, fill values, apply. DO NOT commit real secrets.
# kubectl create secret generic kafka-ui-secret -n farmkart-kafka \
#   --from-literal=KAFKA_UI_USERNAME=admin \
#   --from-literal=KAFKA_UI_PASSWORD='...' \
#   --from-literal=KAFKA_SASL_USERNAME='...' \
#   --from-literal=KAFKA_SASL_PASSWORD='...' \
#   --from-literal=KAFKA_BOOTSTRAP_SERVERS='broker1:9092,broker2:9092'
#
apiVersion: v1
kind: Secret
metadata:
  name: kafka-ui-secret
  namespace: farmkart-kafka
  labels:
    app.kubernetes.io/name: kafka-ui
type: Opaque
stringData:
  KAFKA_UI_USERNAME: "admin"
  KAFKA_UI_PASSWORD: "REPLACE_ME"
  KAFKA_SASL_USERNAME: "REPLACE_ME"
  KAFKA_SASL_PASSWORD: "REPLACE_ME"
  KAFKA_BOOTSTRAP_SERVERS: "kafka-broker-1.internal:9092,kafka-broker-2.internal:9092"
  KAFKA_SASL_JAAS_CONFIG: 'org.apache.kafka.common.security.scram.ScramLoginModule required username="REPLACE_ME" password="REPLACE_ME";'
