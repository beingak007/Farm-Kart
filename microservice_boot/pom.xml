        <!-- ── SonarQube Configuration ── -->
        <!-- Override via GitHub Secrets: SONAR_TOKEN, SONAR_HOST_URL -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>beingakstyle</sonar.organization>
        <sonar.projectKey>beingakstyle_farm-kart-microservice</sonar.projectKey>
        <sonar.projectName>Farm Kart Microservices</sonar.projectName>
        <sonar.java.source>21</sonar.java.source>
        <sonar.java.target>21</sonar.java.target>
        <sonar.coverage.jacoco.xmlReportPaths>
            ${project.build.directory}/site/jacoco/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.exclusions>
            **/generated/**,
            **/*Application.java,
            **/*Config.java,
            **/*Configuration.java,
            **/dto/**,
            **/entity/**,
            **/model/**,
            **/exception/**,
            **/constant/**,
            **/mapper/**
        </sonar.exclusions>
        <sonar.coverage.exclusions>
            **/generated/**,
            **/*Application.java,
            **/*Config.java,
            **/*Configuration.java,
            **/dto/**,
            **/entity/**,
            **/model/**,
            **/exception/**,
            **/constant/**,
            **/mapper/**
        </sonar.coverage.exclusions>

        <!-- ── JaCoCo Coverage Threshold ── -->
        <jacoco.minimum.coverage>0.80</jacoco.minimum.coverage>
    </properties>

